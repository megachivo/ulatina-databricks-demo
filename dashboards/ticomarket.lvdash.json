{
  "datasets": [
    {
      "name": "ds_ventas",
      "displayName": "Ventas diarias",
      "queryLines": [
        "SELECT fecha, provincia, categoria, canal_adquisicion, ordenes, unidades, ingreso_crc, margen_crc\n",
        "FROM gold_ventas_diarias"
      ]
    },
    {
      "name": "ds_riesgo",
      "displayName": "Riesgo de abandono",
      "queryLines": [
        "SELECT cliente_id, provincia, canal_adquisicion, segmento_riesgo, gasto_total_crc, prob_abandono,\n",
        "       CASE WHEN segmento_riesgo = 'Alto' THEN 1 ELSE 0 END AS riesgo_alto,\n",
        "       CASE WHEN segmento_riesgo = 'Alto' THEN gasto_total_crc ELSE 0 END AS gasto_en_riesgo_crc\n",
        "FROM gold_riesgo_abandono"
      ]
    },
    {
      "name": "ds_top_riesgo",
      "displayName": "Top clientes en riesgo",
      "queryLines": [
        "SELECT r.cliente_id, c.nombre, r.provincia, r.canal_adquisicion, r.gasto_total_crc,\n",
        "       ROUND(r.prob_abandono, 3) AS prob_abandono\n",
        "FROM gold_riesgo_abandono r JOIN silver_clientes c USING (cliente_id)\n",
        "WHERE r.segmento_riesgo = 'Alto'\n",
        "ORDER BY r.gasto_total_crc DESC LIMIT 25"
      ]
    },
    {
      "name": "ds_resenas",
      "displayName": "Reseñas analizadas con IA",
      "queryLines": [
        "SELECT fecha, categoria, producto, tema, sentimiento, calificacion, texto\n",
        "FROM gold_resenas_ia"
      ]
    }
  ],
